{
  "compilerOptions": {
    "module": "nodenext",
    "target": "es2022",
    "declarationDir": "build",
    "lib": ["es6", "DOM", "es2016", "es2017", "es2022"],
    "preserveConstEnums": true,
    "declaration": true,
    "sourceMap": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "strict": false,
    "moduleResolution": "nodenext",
    "skipLibCheck": true
  },
  "exclude": ["node_modules","output", "build"]
}
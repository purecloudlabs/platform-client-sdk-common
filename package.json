{
  "name": "purecloud-api-sdk-common",
  "version": "1.0.1",
  "description": "Build tools for the PureCloud Platform API SDKs",
  "type": "module",
  "files": [
    "README.md",
    "main.js",
    "modules"
  ],
  "scripts": {
    "test": "jasmine",
    "browserify": "browserify modules/swagger/swaggerDiffImpl.ts -o docs/swaggerDiffImpl.ts",
    "ios": "tsx sdkBuilder.ts --sdk purecloudswift4",
    "sdk_cli": "tsx sdkBuilder.ts --sdk clisdkclient",
    "sdk_js": "tsx sdkBuilder.ts --sdk purecloudjavascript",
    "sdk_go": "tsx sdkBuilder.ts --sdk purecloudgo",
    "sdk_ios": "tsx sdkBuilder.ts --sdk purecloudios",
    "sdk_java": "tsx sdkBuilder.ts --sdk purecloudjava",
    "sdk_dotnet": "tsx sdkBuilder.ts --sdk pureclouddotnet",
    "sdk_python": "tsx sdkBuilder.ts --sdk purecloudpython",
    "webmessaging": "tsx sdkBuilder.ts --sdk webmessagingjava",
    "snyk_test_builder": "snyk test --file=package-lock.json --severity-threshold=high --skip-unresolved=true"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/purecloudlabs/platform-client-sdk-common.git"
  },
  "author": {
    "name": "Genesys Cloud Developer Evangelists",
    "email": "developerevangelists@genesys.com",
    "url": "https://developer.genesys.cloud/"
  },
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/purecloudlabs/platform-client-sdk-common/issues"
  },
  "dependencies": {
    "dot": "^1.1.3",
    "http-proxy": "^1.18.1",
    "lodash": "^4.18.1",
    "purecloud-platform-client-v2": "^259.0.0",
    "pm2": "^6.0.14",
    "mustache": "^2.3.0",
    "klaw-sync": "^3.0.2",
    "mdjavadoc-api": "^1.0.4",
    "moment-timezone": "^0.6.2",
    "fs-extra": "^11.4.0",
    "@apidevtools/json-schema-ref-parser": "^15.3.5",
    "axios": "^1.19.0",
    "archiver": "^8.0.0",
    "commander": "^15.0.0",
    "pluralize": "^8.0.0",
    "winston": "^3.19.0",
    "js-yaml": "^4.3.1"
  },
  "homepage": "https://github.com/purecloudlabs/platform-client-sdk-common",
  "bin": {
    "sdk-builder": "./sdkBuilder.ts"
  },
  "devDependencies": {
    "@octokit/types": "^17.0.0",
    "@types/archiver": "^8.0.0",
    "@types/dot": "^1.1.7",
    "@types/fs-extra": "^11.0.4",
    "@types/lodash": "^4.17.25",
    "@types/node": "^22.19.18",
    "@types/pluralize": "^0.0.33",
    "@types/js-yaml": "^4.0.9",
    "@types/http-proxy": "^1.17.17",
    "@types/klaw-sync": "^6.0.5",
    "@types/mustache": "^4.2.6",
    "tsx": "^4.22.3",
    "typescript": "^6.0.3"
  }
}
